# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- STT (OpenAI Whisper) ---
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# --- TTS (ElevenLabs) — used by Quest path only ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_ES=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Gemini Live (mobile realtime voice path) ---
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
# Voices: Aoede (warm female, educator), Kore, Leda, Charon, Puck, Fenrir, Orus, Zephyr.
GEMINI_VOICE_NAME=Aoede

# --- Vector store (Chroma local) ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=carmen_lomas_garza
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- KB / artworks ---
ARTWORKS_JSON=../KnowledgeBase/artworks.json

# --- TTS cache ---
TTS_CACHE_DIR=./tts_cache

# --- Server ---
HOST=0.0.0.0
PORT=8000
# Comma-separated origins for CORS (Unity dev origin is null/file://)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,*
